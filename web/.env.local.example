# Copiar a .env.local y completar con los datos de tu proyecto de Supabase.
# Pestaña "Project Settings > API" en supabase.com.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave service_role: SOLO se usa en el servidor y en el worker. NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL base del enlace corto (producción: el dominio del Worker, ej. https://qr.pivotit.cl).
# Si no se define, en desarrollo local el QR apunta a http://localhost:3000/s/<slug>.
NEXT_PUBLIC_SHORT_URL=

# URL pública del sitio (producción: https://qrapp.pivotit.cl). Se usa para el redirect de OAuth.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (sitio web de Cloudflare > Turnstile). Site key va en el frontend;
# la secret key SOLO en el servidor (ruta API). NUNCA la secret key en el frontend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=